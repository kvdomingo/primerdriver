{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/src/route-tree.gen.ts", "!**/src/api/openapi.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "attributePosition": "auto",
    "indentStyle": "space",
    "indentWidth": 2,
    "bracketSpacing": true,
    "lineEnding": "lf",
    "lineWidth": 88
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "quoteStyle": "double"
    }
  },
  "tailwind": {
    "attributes": ["class", "className"],
    "mergeFunctions": ["clsx", "cn"],
    "variantFunctions": ["cva"]
  }
}
